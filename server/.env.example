# Puerto del servidor backend
PORT=3001

# URL de origen permitida para CORS (Frontend)
CORS_ORIGIN=http://localhost:5173

# Google Gemini API Key (de Google AI Studio)
GEMINI_API_KEY=

# Supabase Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Flag opcional para modo demo (permite usar la API sin autenticacion obligatoria)
AUTH_OPTIONAL=true
