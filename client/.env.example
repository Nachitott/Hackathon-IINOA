# Frontend — variables Vite (CONTRATO-API §1)
# URL base de la API Express
VITE_API_URL=http://localhost:3001/api
# true → lib/api.js devuelve mocks (sin red); false → pega a la API real
VITE_USE_MOCK=true
# Supabase (N-14 login / historial) — mismas keys que el back, respetan RLS
VITE_SUPABASE_URL=https://<proyecto>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
